# Copy to .env locally. Do not commit real IDs, usernames or credentials.
M365_MCP_TENANT_ID=
M365_MCP_ENTRA_CLIENT_ID=
M365_MCP_ALLOWED_USERNAME=
M365_MCP_OAUTH_CLIENT_ID=m365-copilot-local
M365_MCP_REDIRECT_URIS=https://your-mcp-client.example/oauth/callback
M365_MCP_TIME_ZONE=Etc/UTC
M365_MCP_EXPIRES_AT=2030-01-01T00:00:00Z
M365_MCP_MAX_GRAPH_REQUESTS=12
M365_MCP_LOGIN_MODE=loopback
M365_MCP_PORT=8787
M365_MCP_ORIGIN=http://127.0.0.1:8787
# Optional historical Copilot chats in this same MCP service. Requires Entra admin consent.
# M365_MCP_HISTORY_ENABLED=true
# M365_MCP_HISTORY_PRIVATE_KEY_PATH=path/to/private.key
# M365_MCP_HISTORY_CERT_THUMBPRINT_SHA256=64-character SHA-256 thumbprint
# M365_MCP_HISTORY_FROM=2026-01-01T00:00:00Z
# M365_MCP_HISTORY_TO=2026-10-01T00:00:00Z
# M365_MCP_HISTORY_MAX_REQUESTS=10
